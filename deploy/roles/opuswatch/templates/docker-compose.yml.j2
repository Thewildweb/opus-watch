# opus.watches production stack — deployed by Ansible (roles/opuswatch).
# Caddy terminates TLS (Let's Encrypt) and proxies to WordPress; MariaDB is
# internal-only. Cloudflare sits in front (orange cloud).
services:
  db:
    image: mariadb:11
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: wordpress
      MARIADB_USER: wordpress
      MARIADB_PASSWORD: ${MYSQL_PASSWORD}
      MARIADB_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 12

  wordpress:
    image: wordpress:php8.3-apache
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_NAME: wordpress
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: ${MYSQL_PASSWORD}
      WORDPRESS_TABLE_PREFIX: wp_
      # Read by mu-plugins/opus-mail-config.php. Not in the database, so it
      # is absent from every database dump and from the admin UI.
      BREVO_API_KEY: ${BREVO_API_KEY}
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_HOME', 'https://{{ site_domain }}');
        define('WP_SITEURL', 'https://{{ site_domain }}');
        define('WP_ENVIRONMENT_TYPE', 'production');
        /* Scheduled tasks run from a real cron (see the opuswatch role), not
           off the back of a visitor's request — a low-traffic shop otherwise
           delivers order mail and stock updates whenever someone happens by. */
        define('DISABLE_WP_CRON', true);
        /* No in-admin file editor; plugin/theme INSTALLS stay possible. */
        define('DISALLOW_FILE_EDIT', true);
        define('FORCE_SSL_ADMIN', true);
        /* Behind Caddy (TLS) and Cloudflare. */
        if (isset($$_SERVER['HTTP_X_FORWARDED_PROTO']) && $$_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https') { $$_SERVER['HTTPS'] = 'on'; }
        if (isset($$_SERVER['HTTP_CF_CONNECTING_IP'])) { $$_SERVER['REMOTE_ADDR'] = $$_SERVER['HTTP_CF_CONNECTING_IP']; }
        /* Object cache (Redis Object Cache plugin, Predis client). */
        define('WP_REDIS_HOST', 'redis');
        define('WP_REDIS_TIMEOUT', 1);
        define('WP_REDIS_READ_TIMEOUT', 1);
        /* Elasticsearch — ElasticPress and the watch-database search. */
        define('EP_HOST', 'http://elasticsearch:9200');
    env_file:
      - wp-salts.env
    volumes:
      - wp_data:/var/www/html
      - ./wp-content/themes/maison-opus:/var/www/html/wp-content/themes/maison-opus
      - ./wp-content/mu-plugins:/var/www/html/wp-content/mu-plugins
      - ./php-uploads.ini:/usr/local/etc/php/conf.d/uploads.ini:ro

  wpcli:
    image: wordpress:cli-php8.3
    profiles: ["tools"]
    depends_on:
      db:
        condition: service_healthy
    user: "33:33"
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_NAME: wordpress
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: ${MYSQL_PASSWORD}
      WORDPRESS_TABLE_PREFIX: wp_
      BREVO_API_KEY: ${BREVO_API_KEY}
      # CLI runs in a different language/MO context than the web — letting it
      # write into the shared persistent cache poisons term links (the /brand/
      # vs /merk/ base bug). CLI gets no persistent object cache.
      WP_REDIS_DISABLED: "true"
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_REDIS_HOST', 'redis');
        define('WP_REDIS_TIMEOUT', 1);
        define('WP_REDIS_READ_TIMEOUT', 1);
        define('EP_HOST', 'http://elasticsearch:9200');
    volumes:
      - wp_data:/var/www/html
      - ./wp-content/themes/maison-opus:/var/www/html/wp-content/themes/maison-opus
      - ./wp-content/mu-plugins:/var/www/html/wp-content/mu-plugins
      # Same PHP limits as the web container: wp-cli runs the whole of
      # WordPress and exhausted the default 128M on `wp plugin list`.
      - ./php-uploads.ini:/usr/local/etc/php/conf.d/uploads.ini:ro
    entrypoint: wp
    command: ["--info"]

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    # Pure cache: bounded memory, LRU eviction, no persistence needed.
    command: ["redis-server", "--maxmemory", "256mb", "--maxmemory-policy", "allkeys-lru", "--save", ""]

  elasticsearch:
    image: elasticsearch:7.17.22
    restart: unless-stopped
    environment:
      discovery.type: single-node
      xpack.security.enabled: "false"
      ES_JAVA_OPTS: "-Xms1g -Xmx1g"
    volumes:
      - es_data:/usr/share/elasticsearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9200/_cluster/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 12

  umami-db:
    image: postgres:15-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: umami
      POSTGRES_USER: umami
      POSTGRES_PASSWORD: ${UMAMI_DB_PASSWORD}
    volumes:
      - umami_db:/var/lib/postgresql/data

  # Privacy-friendly analytics at analytics.{{ site_domain }} (via Caddy).
  umami:
    image: ghcr.io/umami-software/umami:postgresql-latest
    restart: unless-stopped
    depends_on:
      - umami-db
    environment:
      DATABASE_URL: postgresql://umami:${UMAMI_DB_PASSWORD}@umami-db:5432/umami
      DATABASE_TYPE: postgresql
      APP_SECRET: ${UMAMI_APP_SECRET}

  caddy:
    image: caddy:2
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config

volumes:
  db_data:
  wp_data:
  caddy_data:
  caddy_config:
  es_data:
  umami_db:
