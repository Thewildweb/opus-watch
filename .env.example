# ── Project ──────────────────────────────────────────────
COMPOSE_PROJECT_NAME=opus

# ── Database ─────────────────────────────────────────────
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# ── WordPress ────────────────────────────────────────────
WP_TABLE_PREFIX=wp_
WP_DEBUG=1

# Public URL / port the site is served on
WP_PORT=8080
WP_URL=http://localhost:8080

# First-run admin account (created by scripts/install.sh)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=erik@datadepartment.io
WP_TITLE="Maison & Opus"

# ── Tooling ports ────────────────────────────────────────
PMA_PORT=8081
# Elasticsearch host port (9200 is taken by ODC infra, so 9201)
ES_PORT=9201
